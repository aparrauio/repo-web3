# Cadena de conexión de tu cluster de MongoDB Atlas.
# La obtienes en Atlas: Database > Connect > Drivers > Node.js
# Ejemplo (reemplaza usuario, contraseña y cluster):
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster0.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos a usar dentro del cluster.
MONGODB_DB=usuarios_hobbies
